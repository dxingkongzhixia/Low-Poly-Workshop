# ============================================================================
# 低模工坊 · 环境变量模板
#
#   cp .env.example .env      然后按需改
#
# ⚠ 服务是**零依赖**的，**不会自己读 .env**。三种用法：
#   ① docker compose        → 自动读同目录的 .env（直接用）
#   ② shell                 → `set -a; . ./.env; set +a; ./start.sh`
#   ③ PM2                   → 先把变量 export 出来，再 `pm2 start ecosystem.config.js --update-env`
# ============================================================================

# ---- 监听 ----
PORT=8765
# 默认只绑本机（给 nginx / 宝塔反代用）。
# 要直连 / 局域网 / 容器端口映射，改成 0.0.0.0
HOST=127.0.0.1

# ---- ① 整站 Basic Auth（给「人 / 浏览器」）----
# 两个都填才生效。设了以后，网页和 /api/* 都要这组账号密码。
AUTH_USER=
AUTH_PASS=

# ---- ② API token（给「AI / 脚本」，只管 /api/*）----
# 传法：Authorization: Bearer <token>  或  X-API-Token: <token>  或  GET 时 ?token=<token>
#   · 只读 token → 只放 GET / HEAD（给「只看看模型」的 Agent 最安全）
#   · 读写 token → 全放（存模型 / 清缓存 / 删）
# ⚠ 配了 token 就**务必同时开 Basic Auth**：否则浏览器（没有 token）会调不动 /api/*。
API_READ_TOKEN=
API_WRITE_TOKEN=

# ============================================================================
# 最小可用（公网部署，推荐）：
#   HOST=127.0.0.1
#   AUTH_USER=admin
#   AUTH_PASS=换一个强密码
#   API_READ_TOKEN=随便一串长的随机串-只读
#   API_WRITE_TOKEN=另一串长的随机串-读写
#
# Agent 用法示例：
#   curl -H "Authorization: Bearer $API_READ_TOKEN"  http://127.0.0.1:8765/api/models
#   curl -H "X-API-Token: $API_WRITE_TOKEN" -X POST -d @m.json http://127.0.0.1:8765/api/models
# ============================================================================
