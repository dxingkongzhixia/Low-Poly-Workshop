# ============================================================================
# 低模工坊 · 环境变量模板（全部可选）
#
#   cp .env.example .env      然后按需改
#
# ⚠ 服务是**零依赖**的，**不会自己读 .env**。三种用法：
#   ① docker compose  → 自动读同目录的 .env（直接用）
#   ② shell           → `set -a; . ./.env; set +a; ./start.sh`
#   ③ PM2             → 先 export，再 `pm2 start ecosystem.config.js --update-env`
#
# 本项目是开源学习项目，服务端**无鉴权**（/api/* 可读可写）——
# 所以没有密码 / token 之类的变量，只有「监听在哪」这一个开关。
# ============================================================================

# 监听端口
PORT=8765

# 绑定地址：
#   0.0.0.0    = 所有网卡（默认；直连 / 局域网 / 容器端口映射）
#   127.0.0.1  = 只给本机（配合 nginx / 宝塔「反向代理」）
HOST=0.0.0.0
